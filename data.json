": null, "imageUrl": "https://images2.autotrader.com/hn/c/78156f1c7b50469b9b0490551d6b1044.jpg", "source": "autotrader"}, {"id": "793395589", "year": 1995, "make": "Pontiac", "model": "Firebird", "trim": "Convertible", "price": 9500, "mileage": 124000, "location": "Turnersville, NJ", "distanceMi": 30, "url": "https://www.autotrader.com/cars-for-sale/vehicledetails.xhtml?listingId=793395589", "dealer": null, "dealRating": null, "cleanTitle": null, "noAccidents": true, "transmission": null, "imageUrl": "https://images2.autotrader.com/hn/c/5e4e29e2a1f24b5db7fb74de0e41e7a8.jpg", "source": "autotrader"}, {"id": "786146269", "year": 2020, "make": "Ford", "model": "Mustang", "trim": "Premium", "price": 9994, "mileage": 132000, "location": "Langhorne, PA", "distanceMi": 33, "url": "https://www.autotrader.com/cars-for-sale/vehicledetails.xhtml?listingId=786146269", "dealer": null, "dealRating": null, "cleanTitle": null, "noAccidents": true, "transmission": null, "imageUrl": "https://images2.autotrader.com/hn/c/78156f1c7b50469b9b0490551d6b1044.jpg", "source": "autotrader"}, {"id": "788977524", "year": 2009, "make": "BMW", "model": "335i", "trim": "Convertible", "price": 10299, "mileage": 94000, "location": "Horsham, PA", "distanceMi": 15, "url": "https://www.autotrader.com/cars-for-sale/vehicledetails.xhtml?listingId=788977524", "dealer": null, "dealRating": null, "cleanTitle": null, "noAccidents": false, "transmission": null, "imageUrl": "https://images2.autotrader.com/hn/c/a9261aba5ed04efcb5b2f97e78c9d6db.jpg", "source": "autotrader"}, {"id": "792013039", "year": 2010, "make": "Audi", "model": "S5", "trim": "Premium Plus", "price": 10489, "mileage": 92000, "location": "Feasterville Trevose, PA", "distanceMi": 27, "url": "https://www.autotrader.com/cars-for-sale/vehicledetails.xhtml?listingId=792013039", "dealer": null, "dealRating": null, "cleanTitle": null, "noAccidents": false, "transmission": null, "imageUrl": "https://images2.autotrader.com/hn/c/7426212c8bad4d0096864688